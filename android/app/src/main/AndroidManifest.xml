<?xml version="1.0" encoding="utf-8"?>
<!-- Gamma for Android (docs/dev/android.md). One window (MainActivity) kept
     through rotation, a keyboard and the system going light or dark; the way
     in for the files other apps hand it (OpenedEntryActivity), and the Gamma
     Cloud sign-in's way back from the browser (CloudReturnActivity), which
     both pass on to that window; and the FileProvider the shell shares its
     files through. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The page's recordings and dictation (Microphone). Google Play would
         take the permission to mean a microphone is required and hide the
         app from a device without one, where all but recording works. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Which browser opens a Custom Tab or an Auth Tab: the browsers, and
         which of them serve Custom Tabs (CloudSignIn, Navigation). -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".app.GammaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gamma">

        <!-- singleTop, so a tap on the app's icon only brings its task
             forward and leaves what is open above the window (a sign-in
             tab, a picker); files come through OpenedEntryActivity. -->
        <activity
            android:name=".app.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The files other apps open in Gamma, handed on to the window. Not
             excludeFromRecents: when it starts the app's task, the window
             joins that task, which Recents must keep showing. -->
        <activity
            android:name=".shell.OpenedEntryActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <!-- Files' Open with, a browser's downloaded file: OpenedIntake. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>
            <!-- A share sheet's Gamma, one file or several; also the note apps'
                 exports, which carry no type of their own (Notability's .note,
                 GoodNotes' .goodnotes), and which Open with does not offer. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="text/x-markdown" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="image/jpeg" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/gif" />
                <data android:mimeType="image/webp" />
                <data android:mimeType="image/heic" />
                <data android:mimeType="image/heif" />
                <data android:mimeType="image/svg+xml" />
            </intent-filter>
        </activity>

        <!-- The browser's way back after Gamma Cloud's sign-in (CloudWire.CALLBACK_SCHEME). -->
        <activity
            android:name=".shell.CloudReturnActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="cloud-signin"
                    android:scheme="gamma-android" />
            </intent-filter>
        </activity>

        <!-- The server's log and the files the shell saves or hands on (res/xml/file_paths.xml). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
